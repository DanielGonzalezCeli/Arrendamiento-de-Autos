# API Gateway de RutaLibre (no tiene secretos: la autenticación la siguen validando los microservicios)
PORT=8080
# URL base de cada microservicio
MS_RESERVAS_URL=http://localhost:3000
MS_IDENTIDAD_URL=http://localhost:3002
MS_CLIENTES_URL=http://localhost:3003
MS_INVENTARIO_URL=http://localhost:3004
# Peticiones por minuto y por IP de cliente (0 = sin límite)
RATE_LIMIT_PER_MINUTE=300
# Espera máxima de un microservicio antes de responder 504
PROXY_TIMEOUT_MS=30000
# Proxies de confianza delante del gateway: 0 en local, 1 en Azure App Service
TRUST_PROXY_HOPS=0
LOG_LEVEL=info

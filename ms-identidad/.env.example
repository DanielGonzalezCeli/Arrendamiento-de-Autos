NODE_ENV=development
PORT=3002
# Misma instancia de PostgreSQL que ms-reservas, pero ms-identidad solo usa su schema "identidad"
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autos_db
# Clave privada RSA (PEM, con \n escapados) que firma los JWT de usuario. Obligatoria en producción;
# en desarrollo, sin ella se genera una efímera (las sesiones se pierden al reiniciar).
IDENTITY_JWT_PRIVATE_KEY=
USER_JWT_EXPIRES_IN=2h
CORS_ORIGINS=http://localhost:5173
# ms-reservas: historial de cada usuario (reservas, reseñas, bloqueos) para el panel de usuarios
MS_RESERVAS_URL=http://localhost:3001
# 0 = conexión directa; 1 detrás del gateway en local; 2 en Azure (front-end de Azure + gateway)
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
# Contraseñas de los usuarios de demostración (solo se crean si faltan; en desarrollo hay valores por defecto)
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=

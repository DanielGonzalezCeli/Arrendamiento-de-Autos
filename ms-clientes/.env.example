NODE_ENV=development
PORT=3003
# Misma instancia de PostgreSQL que los demás servicios, pero ms-clientes solo usa su schema "clientes"
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autos_db
# X-API-Key de Booking (la misma que en ms-reservas). Obligatoria en producción.
BOOKING_API_KEY=
# ms-identidad: su JWKS verifica los tokens de los administradores (búsquedas del panel vía ms-reservas)
IDENTITY_URL=http://localhost:3002
# 0 = conexión directa; 1 detrás del gateway en local; 2 en Azure (front-end de Azure + gateway)
TRUST_PROXY_HOPS=0
LOG_LEVEL=info

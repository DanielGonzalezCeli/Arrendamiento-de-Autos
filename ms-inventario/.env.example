NODE_ENV=development
PORT=3004
# Misma instancia de PostgreSQL que los demás servicios, pero ms-inventario solo usa su schema "inventario"
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autos_db
# RabbitMQ (CloudAMQP en producción; amqps://usuario:clave@host/vhost). Nunca subirla al repositorio.
AMQP_URL=
# En local, usa nombres propios para no mezclar tus eventos con los de producción si compartes el broker
AMQP_EXCHANGE=rutalibre.eventos.local
AMQP_QUEUE=ms-inventario.flota.local
# Envío de stock a Booking: off | grpc (Tailscale) | http (respaldo en la nube)
STOCK_SYNC_MODE=off
BOOKING_GRPC_TARGET=localhost:50051
BOOKING_STOCK_HTTP_URL=https://booking-core-api.azurewebsites.net/api/v3/inventory/stock
BOOKING_API_KEY=
NODE_ID=NODE_AUT_RUTALIBRE
# ms-identidad: verifica el token del administrador en la API interna
IDENTITY_URL=http://localhost:3002
TRUST_PROXY_HOPS=0
LOG_LEVEL=info

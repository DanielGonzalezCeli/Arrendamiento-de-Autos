# Copiar como backend/.env. NUNCA subir .env al repositorio.
NODE_ENV=development
PORT=3000
# Local: docker compose up -d (en la raíz). Producción: Supabase → Session pooler (puerto 5432) con ?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autos_db
# Orígenes del frontend permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173
# URL pública de esta instancia (Swagger "Try it out" y enlaces HATEOAS)
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# JWT de usuarios web (mínimo 32 caracteres). Generar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
USER_JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres
USER_JWT_EXPIRES_IN=2h
# Contraseñas de los usuarios de demo que crea el seed (en producción son obligatorias para crearlos)
SEED_ADMIN_PASSWORD=
SEED_CUSTOMER_PASSWORD=
SEED_HUB_CLIENT_SECRET=

# ── API de integración (Booking Hub) ─────────────────────────────────────
INTEGRATION_JWT_ISSUER=rutalibre-local-idp
INTEGRATION_JWT_AUDIENCE=autos-api
# RDA2: JWKS del IdP central (si se define, los tokens se verifican contra él)
INTEGRATION_JWKS_URL=
# RDA1: emisor OAuth2 local (POST /oauth2/token, /.well-known/jwks.json)
LOCAL_OAUTH_ISSUER_ENABLED=true
# Clave RSA PKCS#8 en PEM en una sola línea (saltos de línea escritos como \n). Vacía = clave efímera (los tokens caducan al reiniciar)
LOCAL_OAUTH_PRIVATE_KEY=
INTEGRATION_TOKEN_TTL_SECONDS=3600
# lenient (RDA1): cualquier X-Affiliate-Id entero · strict: debe existir en affiliates
AFFILIATE_VALIDATION=lenient
API_DEPRECATION_DATE=

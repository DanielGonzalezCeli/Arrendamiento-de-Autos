# Copiar como backend/.env. NUNCA subir .env al repositorio.
NODE_ENV=development
PORT=3000
# Local: docker compose up -d (en la raíz). Producción: Supabase → Session pooler (puerto 5432) con ?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autos_db
# Orígenes del frontend permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173
# URL pública de esta instancia (Swagger "Try it out" y enlaces HATEOAS)
PUBLIC_BASE_URL=http://localhost:3000
# Proxies de confianza delante de la API (0 = directo; 1 detrás del gateway en local; 2 en Azure)
TRUST_PROXY_HOPS=0
LOG_LEVEL=info

# Secreto (mínimo 32 caracteres) de los enlaces de vouchers y de la clave de los secretos de webhooks.
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
USER_JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres
# ms-identidad (fase B): emite los tokens de usuario; aquí se verifican con su JWKS y se consulta el estado de la cuenta
IDENTITY_URL=http://localhost:3002
# ms-clientes (fase C): clientes cross-platform del contrato v3.1; las reservas guardan solo su client_id
CLIENTS_URL=http://localhost:3003
# ms-inventario (fase D): estado del envío de stock a Booking para el panel /admin/booking
INVENTORY_URL=http://localhost:3004
# RabbitMQ (fase D): aquí se publican los eventos de flota. Vacía = eventos en memoria (nadie los recibe).
# En local usa un exchange propio para no mezclar tus eventos con los de producción si compartes el broker.
AMQP_URL=
AMQP_EXCHANGE=rutalibre.eventos.local
# Secreto del cliente OAuth2 de demo que crea el seed (en producción es obligatorio para crearlo).
# Los usuarios de demo (admin, cliente) los crea ms-identidad.
SEED_HUB_CLIENT_SECRET=

# ── API de integración (Booking Hub) ─────────────────────────────────────
INTEGRATION_JWT_ISSUER=rutalibre-local-idp
INTEGRATION_JWT_AUDIENCE=autos-api
# RDA2: JWKS del IdP central (si se define, los tokens se verifican contra él)
INTEGRATION_JWKS_URL=
# RDA1: emisor OAuth2 local (POST /oauth2/token, /.well-known/jwks.json)
LOCAL_OAUTH_ISSUER_ENABLED=true
# Clave RSA PKCS#8 en PEM en una sola línea (saltos de línea escritos como \n). Vacía = clave efímera (los tokens caducan al reiniciar)
LOCAL_OAUTH_PRIVATE_KEY=
INTEGRATION_TOKEN_TTL_SECONDS=3600
# lenient (RDA1): cualquier X-Affiliate-Id entero · strict: debe existir en affiliates
AFFILIATE_VALIDATION=lenient
API_DEPRECATION_DATE=

# ── Eventos / webhooks ───────────────────────────────────────────────────
# Cada cuánto se entregan webhooks y se hace limpieza (ms). 0 = desactivado
WEBHOOK_DISPATCH_INTERVAL_MS=10000
MAINTENANCE_INTERVAL_MS=600000
# Clave AES-256 (32 bytes base64) para cifrar los secrets de webhooks. Vacía = derivada de USER_JWT_SECRET (HKDF)
DATA_ENCRYPTION_KEY=

# ── Reto 2: integración con Booking Prototipo (contrato v3 en /api/v3 + inventory.proto) ──
# Clave que Booking envía en X-API-Key (su TIENDA_AUTOS_API_KEY). Se comparte por privado. Vacía = rutas abiertas (solo desarrollo)
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOOKING_API_KEY=
# ID del nodo registrado en el dashboard de Booking (service_id del gRPC)
NODE_ID=NODE_AUT_RUTALIBRE
PARTNER_NAME=RutaLibre Renta de Autos
# URL pública del frontend (fotos del catálogo v3). Vacía = primer origen de CORS_ORIGINS
PUBLIC_WEB_URL=
# Fase D: el stock a Booking lo envía ms-inventario (STOCK_SYNC_MODE, BOOKING_GRPC_TARGET… van en ms-inventario/.env).
# Aquí solo: cada cuánto se publica el estado de toda la flota (flota.snapshot, ms). 0 = solo al reservar o cancelar
FLEET_SNAPSHOT_INTERVAL_MS=30000
# Log en archivo de la API v3 (correlation_id + idempotency_key). off = desactivado
INTEGRATION_LOG_FILE=logs/integration-v3.log
